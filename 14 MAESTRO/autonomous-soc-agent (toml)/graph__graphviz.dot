digraph "Autonomous SOC Triage Agent" {
	graph [bb="0,0,1019,165",
		bgcolor=white,
		compound=true,
		fontname=Arial,
		fontsize=16,
		label="Autonomous SOC Triage Agent",
		labelloc=t,
		lheight=0.25,
		lp="509.5,152",
		lwidth=3.14,
		nodesep=0.6,
		pad=0.5,
		rankdir=LR,
		ranksep=0.8,
		splines=polyline
	];
	node [label="\N"];
	subgraph "cluster_graph_foundation-models" {
		graph [bb="243,8,422,91",
			color="#bdbdbd",
			fillcolor="#e8f5e9",
			fontcolor="#333333",
			fontname="Arial Bold",
			fontsize=14,
			label="L1 — Foundation Models",
			lheight=0.21,
			lp="332.5,79.5",
			lwidth=2.26,
			penwidth=1,
			style="filled,rounded"
		];
		graph_agent_soc_agent	[color="#e53935",
			fillcolor="#a5d6a7",
			fontcolor="#1f2937",
			fontname=Arial,
			fontsize=11,
			height=0.59722,
			label=<<B>SOC Triage Agent</B><BR/><FONT POINT-SIZE='9'><I>task-oriented | self-modifying</I></FONT><BR/><FONT POINT-SIZE='9'><FONT COLOR='#b71c1c'>C:16</FONT> <FONT COLOR='#b23c00'>H:22</FONT> <FONT COLOR='#7a5400'>M:17</FONT></FONT>>,
			margin="0.2,0.1",
			penwidth=2,
			pos="332,38",
			shape=box,
			style="filled,rounded",
			width=2.0278];
		graph_agent_soc_agent:w -> graph_agent_soc_agent:w	[arrowhead=vee,
			color="#388e3c",
			fontcolor="#388e3c",
			fontname=Arial,
			fontsize=9,
			label=" CL-evade-and-pivot (2 layers)",
			lp="62.5,38",
			penwidth=1.5,
			pos="e,259,38 259,38 214.33,59.5 125,59.5 125,38 125,17.928 202.86,16.595 249.55,34.001",
			style=dashed];
	}
	subgraph cluster_graph_observability {
		graph [bb="779,8,1019,91",
			color="#bdbdbd",
			fillcolor="#e0f7fa",
			fontcolor="#333333",
			fontname="Arial Bold",
			fontsize=14,
			label="L5 — Evaluation and Observability",
			lheight=0.21,
			lp="899,79.5",
			lwidth=3.11,
			penwidth=1,
			style="filled,rounded"
		];
		graph_agent_analyst_feedback	[color="#e53935",
			fillcolor="#80deea",
			fontcolor="#1f2937",
			fontname=Arial,
			fontsize=11,
			height=0.59722,
			label=<<B>Analyst Feedback Loop</B><BR/><FONT POINT-SIZE='9'><I>human-in-the-loop | reactive</I></FONT><BR/><FONT POINT-SIZE='9'><FONT COLOR='#b71c1c'>C:2</FONT> <FONT COLOR='#b23c00'>H:11</FONT> <FONT COLOR='#7a5400'>M:9</FONT></FONT>>,
			margin="0.2,0.1",
			penwidth=2,
			pos="899,38",
			shape=box,
			style="filled,rounded",
			width=2.1111];
	}
	graph_agent_soc_agent -> graph_agent_analyst_feedback	[arrowhead=vee,
		color="#8d6e63",
		fontcolor="#8d6e63",
		fontname=Arial,
		fontsize=9,
		label=" CL-goal-drift: Adversarial feedback drifts objective toward false-negative bias",
		lp="600.5,43",
		penwidth=1.5,
		pos="e,822.7,38 405.13,38 509.28,38 701.42,38 812.54,38"];
	security_summary_graph	[fillcolor="#ffe0b2",
		fontcolor="#bf360c",
		fontname=Arial,
		fontsize=10,
		height=0.5,
		label="Security & Compliance\n1 preventive | 0 detective",
		pos="332,121",
		shape=note,
		style=filled,
		width=1.75];
}
