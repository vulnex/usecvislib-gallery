697.82,98.104",
		protocol=PostgreSQL,
		sanitizesInput=True,
		style=solid];
	order_service -> order_db	[authenticatesSource=True,
		color="#34495e",
		fontname=Arial,
		fontsize=10,
		isEncrypted=True,
		isPII=True,
		label="SQL Queries",
		lp="635.5,407.5",
		pos="e,729.49,214.02 552.44,422.94 558.16,420.21 563.81,417.22 569,414 626.58,378.33 650.86,373.07 684,314 698.34,288.45 680.21,274.29 \
695,249 701.52,237.84 711.35,228.07 721.42,220.06",
		protocol=PostgreSQL,
		sanitizesInput=True,
		style=solid];
	order_service -> message_queue	[color="#34495e",
		fontname=Arial,
		fontsize=10,
		isEncrypted=True,
		label="Async Messages",
		lp="635.5,304.5",
		pos="e,705.58,158.8 553.61,426.98 559.48,423.54 564.85,419.28 569,414 600.97,373.33 551.68,336.8 587,299 617.18,266.7 654.7,310.1 684,\
277 699.99,258.94 680.58,188.34 695,169 695.92,167.77 696.9,166.59 697.95,165.47",
		protocol=AMQP,
		style=solid];
	payment_service -> third_party_api	[authenticatesDestination=True,
		checksDestinationRevocation=True,
