digraph "Microservices Architecture" {
	graph [bb="0,0,837,521",
		bgcolor=white,
		fontname=Arial,
		rankdir=LR
	];
	node [label="\N"];
	subgraph cluster_public_zone {
		graph [bb="0,330,146,513",
			color="#e74c3c",
			fontname=Arial,
			label="Public Zone (Internet)",
			lheight=0.21,
			lp="73,501.5",
			lwidth=1.81,
			penwidth=2,
			style=dashed
		];
		mobile_app	[description="iOS/Android mobile application",
			fillcolor="#95a5a6",
			fontcolor=white,
			fontname=Arial,
			height=0.5,
			isAdmin=False,
			label="Mobile App",
			pos="73,410",
			shape=rectangle,
			style="filled,dashed",
			width=1.1667];
		web_client	[description="Single-page web application",
			fillcolor="#95a5a6",
			fontcolor=white,
			fontname=Arial,
			height=0.5,
			isAdmin=False,
			label="Web Client",
			pos="73,356",
			shape=rectangle,
			style="filled,dashed",
			width=1.1528];
		third_party_api	[description="External payment processor API",
			fillcolor="#95a5a6",
			fontcolor=white,
			fontname=Arial,
			height=0.5,
			isTrusted=False,
			label="Third-Party API",
			pos="73,464",
			shape=rectangle,
			style="filled,dashed",
			width=1.5];
	}
	subgraph cluster_dmz {
		graph [bb="230,330,342,405",
			color="#e74c3c",
			fontname=Arial,
			label=DMZ,
			lheight=0.21,
			lp="286,393.5",
			lwidth=0.43,
			penwidth=2,
			style=dashed
		];
		api_gateway	[authenticatesSource=True,
			checksInputBounds=True,
			description="Central entry point for all API requests",
			fillcolor="#3498db",
			fontcolor=white,
			fontname=Arial,
			hasAccessControl=True,
			height=0.5,
			implementsCSRFToken=True,
			isServer=True,
			label="API Gateway",
			pos="286,356",
			sanitizesInput=True,
			shape=rectangle,
			style=filled,
			width=1.3333];
	}
	subgraph cluster_internal_services {
		graph [bb="429,253,829,490",
			color="#e74c3c",
			fontname=Arial,
			label="Internal Service Mesh",
			lheight=0.21,
			lp="629,478.5",
			lwidth=1.83,
			penwidth=2,
			style=dashed
		];
		auth_service	[authenticatesSource=True,
			description="Handles authentication and authorization",
			fillcolor="#3498db",
			fontcolor=white,
			fontname=Arial,
			hasAccessControl=True,
			height=0.5,
			implementsNonce=True,
			isHardened=True,
			isServer=True,
			label="Auth Service",
			pos="503,279",
			shape=rectangle,
			style=filled,
			width=1.2917];
		user_service	[description="User profile management",
			encodesOutput=True,
			fillcolor="#3498db",
			fontcolor=white,
			fontname=Arial,
			hasAccessControl=True,
			height=0.5,
			isServer=True,
			label="User Service",
			pos="503,333",
			sanitizesInput=True,
			shape=rectangle,
			style=filled,
			width=1.3056];
		order_service	[checksInputBounds=True,
			description="Order processing and management",
			fillcolor="#3498db",
			fontcolor=white,
			fontname=Arial,
			hasAccessControl=True,
			height=0.5,
			isServer=True,
			label="Order Service",
			pos="503,441",
			sanitizesInput=True,
			shape=rectangle,
			style=filled,
			width=1.4028];
		payment_service	[description="Payment processing with PCI compliance",
			fillcolor="#3498db",
			fontcolor=white,
			fontname=Arial,
			handlesResourceConsumption=True,
			hasAccessControl=True,
			height=0.5,
			isHardened=True,
			isServer=True,
			label="Payment Service",
			pos="761.5,441",
			sanitizesInput=True,
			shape=rectangle,
			style=filled,
			width=1.6528];
		order_service -> payment_service	[authenticatesDestination=True,
			authenticatesSource=True,
			color="#34495e",
			data=SECRET,
			fontname=Arial,
			fontsize=10,
			isEncrypted=True,
			label=gRPC,
			lp="635.5,446.5",
			pos="e,701.89,441 553.76,441 593.01,441 648.19,441 691.67,441",
			protocol=gRPC,
			style=solid];
		notification_service	[description="Email and push notification delivery",
			encodesOutput=True,
			fillcolor="#3498db",
			fontcolor=white,
			fontname=Arial,
			height=0.5,
			isServer=True,
			label="Notification Service",
			pos="503,387",
			shape=rectangle,
			style=filled,
			width=1.8333];
	}
	subgraph cluster_data_tier {
		graph [bb="695,8,828,245",
			color="#e74c3c",
			fontname=Arial,
			label="Data Tier",
			lheight=0.21,
			lp="761.5,233.5",
			lwidth=0.78,
			penwidth=2,
			style=dashed
		];
		user_db	[description="PostgreSQL database for user data",
			fillcolor="#2ecc71",
			fontcolor=white,
			fontname=Arial,
			hasAccessControl=True,
			hasBackup=True,
			height=0.5,
			isAuditLogged=True,
			isEncrypted=True,
			isSQL=True,
			label="User Database",
			pos="761.5,88",
			shape=cylinder,
			storesCredentials=True,
			storesPII=True,
			style=filled,
			width=1.4861];
		order_db	[description="PostgreSQL database for orders",
			fillcolor="#2ecc71",
			fontcolor=white,
			fontname=Arial,
			hasAccessControl=True,
			hasBackup=True,
			height=0.5,
			isAuditLogged=True,
			isEncrypted=True,
			isSQL=True,
			label="Order Database",
			pos="761.5,196",
			shape=cylinder,
			storesPII=True,
			style=filled,
			width=1.5694];
		redis_cache	[description="In-memory cache for sessions",
			fillcolor="#2ecc71",
			fontcolor=white,
			fontname=Arial,
			hasAccessControl=True,
			height=0.5,
			isEncrypted=False,
			isSQL=False,
			isShared=True,
			label="Redis Cache",
			pos="761.5,34",
			shape=cylinder,
			style=filled,
			width=1.3056];
		message_queue	[description="RabbitMQ for async messaging",
			fillcolor="#2ecc71",
			fontcolor=white,
			fontname=Arial,
			height=0.5,
			isEncrypted=True,
			isSQL=False,
			isShared=True,
			label="Message Queue",
			pos="761.5,142",
			shape=cylinder,
			style=filled,
			width=1.625];
	}
	mobile_app -> api_gateway	[authenticatesDestination=True,
		color="#34495e",
		data=CONFIDENTIAL,
		fontname=Arial,
		fontsize=10,
		isEncrypted=True,
		label="HTTPS/REST",
		lp="188,392.5",
		pos="e,237.66,368.12 115.18,399.46 147.3,391.24 192.29,379.73 227.89,370.62",
		protocol=HTTPS,
		style=solid];
	web_client -> api_gateway	[authenticatesDestination=True,
		color="#34495e",
		data=CONFIDENTIAL,
		fontname=Arial,
		fontsize=10,
		isEncrypted=True,
		label="HTTPS/REST",
		lp="188,361.5",
		pos="e,237.81,356 114.68,356 146.73,356 191.8,356 227.53,356",
		protocol=HTTPS,
		style=solid];
	api_gateway -> auth_service	[authenticatesSource=True,
		color="#34495e",
		fontname=Arial,
		fontsize=10,
		isCredentials=True,
		isEncrypted=True,
		label="JWT Validation",
		lp="385.5,332.5",
		pos="e,456.26,292.21 325.55,337.97 334.18,334.16 343.34,330.31 352,327 382.85,315.22 417.97,303.88 446.47,295.17",
		protocol=gRPC,
		style=solid];
	api_gateway -> user_service	[authenticatesSource=True,
		color="#34495e",
		fontname=Arial,
		fontsize=10,
		isEncrypted=True,
		isPII=True,
		label=gRPC,
		lp="385.5,353.5",
		pos="e,455.67,337.96 334.18,350.95 367.03,347.44 411,342.74 445.69,339.02",
		protocol=gRPC,
		style=solid];
	api_gateway -> order_service	[authenticatesSource=True,
		color="#34495e",
		fontname=Arial,
		fontsize=10,
		isEncrypted=True,
		label=gRPC,
		lp="385.5,414.5",
		pos="e,452.44,422.92 330.04,374.02 358.12,385.66 395.62,401.01 429,414 433.49,415.75 438.14,417.53 442.82,419.3",
		protocol=gRPC,
		style=solid];
	auth_service -> redis_cache	[color="#34495e",
		fontname=Arial,
		fontsize=10,
		isCredentials=True,
		isEncrypted=False,
		label="Session/Token Cache",
		lp="635.5,91.5",
		note="Consider encrypting Redis connections",
		pos="e,714.39,37.173 506.6,260.88 513.02,222.78 533.22,133.93 587,86 619.29,57.219 666.98,44.355 704.19,38.611",
		protocol=Redis,
		style=solid];
	user_service -> user_db	[authenticatesSource=True,
		color="#34495e",
		fontname=Arial,
		fontsize=10,
		isCredentials=True,
		isEncrypted=True,
		isPII=True,
		label="SQL Queries",
		lp="635.5,166.5",
